# =================================================================
# REGISTRYX CONFIGURATION EXAMPLE
# =================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Update all passwords and secrets before deployment.
# 3. Choose your deployment mode (Cloud vs On-Prem).
# =================================================================

# --- 🔐 SECURITY (MUST CHANGE!) ---
POSTGRES_PASSWORD=your-secure-db-password
MINIO_ROOT_PASSWORD=your-secure-storage-password
JWT_SECRET=generate-a-long-random-string-here

# --- 📦 STORAGE SETTINGS ---
MINIO_ROOT_USER=admin
S3_BUCKET=registryx-data
MINIO_SECURE=false

# --- 💰 COST INTELLIGENCE SETUP ---
COST_MODE=ONPREM

# IF CLOUD MODE:
STORAGE_COST_PER_GB_MONTH=0.023
BANDWIDTH_COST_PER_GB=0.09

# IF ONPREM MODE:
STORAGE_CAPACITY_TB=50
STORAGE_COST_PER_GB_MONTH=0.03

# --- 🌐 NETWORK & EMAIL ---
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enterprise License Key (Get one from support@registryx.io)
# REGISTRYX_LICENSE_KEY=

# Email Setup (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=noreply@registryx.io

# Environment
POLICY_ENVIRONMENT=prod
